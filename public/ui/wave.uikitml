<style>
  .root {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 30;
    gap: 12;
    background-color: rgba(10, 0, 0, 0.92);
    border-radius: 16;
    border-color: rgba(255, 200, 60, 0.5);
    border-width: 2;
    width: 380;
  }
  .wave-label {
    font-size: 16;
    color: #ff8866;
  }
  .wave-num {
    font-size: 48;
    color: #ffdd44;
    font-weight: 700;
  }
  .clear-text {
    font-size: 22;
    color: #44dd88;
    font-weight: 600;
  }
  .bonus-text {
    font-size: 14;
    color: #44ddff;
  }
  .pause-title {
    font-size: 24;
    color: #ff8866;
    font-weight: 700;
  }
  .btn {
    padding: 12;
    background-color: rgba(255, 60, 40, 0.15);
    border-radius: 8;
    border-color: rgba(255, 80, 60, 0.4);
    border-width: 1;
    width: 200;
    align-items: center;
    cursor: pointer;
  }
  .btn-text {
    font-size: 16;
    color: #ffffff;
    font-weight: 600;
  }
</style>
<Panel class="root">
  <div class="wave-label" id="wave-label">WAVE COMPLETE</div>
  <div class="wave-num" id="wave-num">1</div>
  <div class="clear-text" id="clear-text">GREAT WORK!</div>
  <div class="bonus-text" id="bonus-text"> </div>
  <div class="btn" id="btn-resume" style="display: none">
    <div class="btn-text">RESUME</div>
  </div>
  <div class="btn" id="btn-quit-pause" style="display: none">
    <div class="btn-text">QUIT</div>
  </div>
</Panel>
