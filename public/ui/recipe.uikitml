<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 24;
    gap: 10;
    background-color: rgba(10, 0, 0, 0.94);
    border-radius: 14;
    border-color: rgba(255, 80, 60, 0.5);
    border-width: 1;
    width: 400;
  }
  .title {
    font-size: 22;
    color: #ff8866;
    font-weight: 700;
  }
  .divider {
    width: 340;
    height: 1;
    background-color: rgba(255, 80, 60, 0.3);
  }
  .recipe-card {
    flex-direction: column;
    gap: 4;
    width: 340;
    padding: 10;
    background-color: rgba(255, 60, 40, 0.08);
    border-radius: 8;
    border-color: rgba(255, 80, 60, 0.2);
    border-width: 1;
  }
  .recipe-name {
    font-size: 16;
    color: #ffdd44;
    font-weight: 600;
  }
  .recipe-desc {
    font-size: 11;
    color: #cccccc;
  }
  .recipe-steps {
    font-size: 12;
    color: #ff8866;
  }
  .recipe-points {
    font-size: 11;
    color: #44ddff;
  }
  .btn {
    padding: 12;
    background-color: rgba(255, 60, 40, 0.15);
    border-radius: 8;
    border-color: rgba(255, 80, 60, 0.4);
    border-width: 1;
    width: 200;
    align-items: center;
    cursor: pointer;
  }
  .btn-text {
    font-size: 14;
    color: #ffffff;
    font-weight: 600;
  }
</style>
<Panel class="root">
  <div class="title">RECIPE BOOK</div>
  <div class="divider"></div>
  <div class="recipe-card">
    <div class="recipe-name">NIGIRI</div>
    <div class="recipe-desc">Classic rice-topped sushi</div>
    <div class="recipe-steps">Rice + Fish = Nigiri</div>
    <div class="recipe-points">100 pts</div>
  </div>
  <div class="recipe-card">
    <div class="recipe-name">MAKI ROLL</div>
    <div class="recipe-desc">Seaweed-wrapped roll</div>
    <div class="recipe-steps">Nori + Rice + Fish = Maki</div>
    <div class="recipe-points">150 pts</div>
  </div>
  <div class="recipe-card">
    <div class="recipe-name">TEMAKI</div>
    <div class="recipe-desc">Hand roll with topping</div>
    <div class="recipe-steps">Nori + Rice + Fish + Topping = Temaki</div>
    <div class="recipe-points">250 pts</div>
  </div>
  <div class="recipe-card">
    <div class="recipe-name">SASHIMI</div>
    <div class="recipe-desc">Pure sliced fish</div>
    <div class="recipe-steps">Fish only = Sashimi</div>
    <div class="recipe-points">80 pts</div>
  </div>
  <div class="divider"></div>
  <div class="btn" id="btn-back-recipe">
    <div class="btn-text">BACK</div>
  </div>
</Panel>
